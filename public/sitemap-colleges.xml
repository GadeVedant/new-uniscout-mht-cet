<?xml version="1.0" encoding="UTF-8"?>
<!--
  Programmatic college sitemap.
  In production, generate this file at build time by iterating over
  MHTCET_CAP_DATA.xlsx and emitting one <url> per unique college-branch combo.

  Example entry:
  <url>
    <loc>https://uniscout.in/college/vjti-mumbai-ce</loc>
    <lastmod>2026-04-08</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>

  Recommended build script: scripts/generate-sitemap.ts
  Run: npx tsx scripts/generate-sitemap.ts
-->
