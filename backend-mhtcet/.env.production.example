# Copy these into Railway → your backend service → Variables

PORT=5001
NODE_ENV=production
CORS_ORIGIN=https://uniscout.in

# --- Option A: single merged file ---
# DATA_FILE_PATH=./MHTCET_CAP_DATA.xlsx

# --- Option B: folder of multiple files (your cap*.csv files in ml-service/data) ---
# This is the default — ml-service/data contains cap1_2022.csv, cap2_2022.csv, etc.
DATA_DIR=../ml-service/data

# Optional: placement CSV (leave blank until you have the data)
PLACEMENT_DATA_PATH=./data/placements.csv

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
