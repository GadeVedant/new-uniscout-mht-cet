# Copy these into Railway → your backend service → Variables

PORT=5001
NODE_ENV=production
CORS_ORIGIN=https://uniscout.in

# Backend URL (for reference)
BACKEND_URL=https://uniscout-backend-vyp3.onrender.com

# Data dir — Railway clones the full repo so this path works
DATA_DIR=../ml-service/data

# ML service URL — set this to your HF Spaces URL after deploying
ML_SERVICE_URL=https://YOUR-USERNAME-uniscout-ml-service.hf.space

# Optional: placement CSV
PLACEMENT_DATA_PATH=./data/placements.csv

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
